<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">beehexa_hexasync_log_form.log_form_data_source</item>
		</item>
		<item name="label" xsi:type="string" translate="true">General Information</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
	</argument>
	<settings>
		<buttons>
			<button name="back" class="Beehexa\HexaSync\Block\Adminhtml\Log\Edit\BackButton"/>
		</buttons>
		<namespace>beehexa_hexasync_log_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>beehexa_hexasync_log_form.log_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="log_form_data_source">
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider name="log_form_data_source" class="Beehexa\HexaSync\Model\Log\DataProvider">
			<settings>
				<requestFieldName>log_id</requestFieldName>
				<primaryFieldName>log_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<fieldset name="general">
		<settings>
			<label>General</label>
		</settings>
		<field name="created_at" formElement="date" sortOrder="0">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">created_at</label>
				<dataScope>created_at</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="profile_name" formElement="input" sortOrder="10">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Profile Name</label>
				<dataScope>profile_name</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="task_name" formElement="input" sortOrder="20">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Task Name</label>
				<dataScope>task_name</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="action_type" formElement="input" sortOrder="30">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">action_type</label>
				<dataScope>action_type</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="reference_info" formElement="input" sortOrder="40">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">reference_info</label>
				<dataScope>reference_info</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="message" formElement="textarea" sortOrder="50">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Message</label>
				<dataScope>message</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="push_note" formElement="textarea" sortOrder="60">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Push Note</label>
				<dataScope>push_note</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="error" formElement="textarea" sortOrder="70">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Error message</label>
				<dataScope>error</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="task_id" formElement="input" sortOrder="80">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Task Id</label>
				<dataScope>task_id</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="task_status" formElement="input" sortOrder="90">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Task Status</label>
				<dataScope>task_status</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="executed_at" formElement="input" sortOrder="100">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Executed At</label>
				<dataScope>executed_at</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="execute_at" formElement="input" sortOrder="110">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Execute At</label>
				<dataScope>execute_at</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="retry_count" formElement="input" sortOrder="120">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">log</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Retry Count</label>
				<dataScope>retry_count</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
	</fieldset>
</form>
