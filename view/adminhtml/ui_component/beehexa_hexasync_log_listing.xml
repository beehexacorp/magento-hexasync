<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">beehexa_hexasync_log_listing.beehexa_hexasync_log_listing_data_source</item>
		</item>
	</argument>
	<settings>
		<spinner>beehexa_hexasync_log_columns</spinner>
		<deps>
			<dep>beehexa_hexasync_log_listing.beehexa_hexasync_log_listing_data_source</dep>
		</deps>
		<buttons/>
	</settings>
	<dataSource name="beehexa_hexasync_log_listing_data_source" component="Magento_Ui/js/grid/provider">
		<settings>
			<storageConfig>
				<param name="indexField" xsi:type="string">log_id</param>
			</storageConfig>
			<updateUrl path="mui/index/render"/>
		</settings>
		<aclResource>Beehexa_HexaSync::log</aclResource>
		<dataProvider name="beehexa_hexasync_log_listing_data_source" class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
			<settings>
				<requestFieldName>id</requestFieldName>
				<primaryFieldName>log_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<listingToolbar name="listing_top">
		<settings>
			<sticky>true</sticky>
		</settings>
		<bookmark name="bookmarks"/>
		<filters name="listing_filters"/>
		<paging name="listing_paging"/>
	</listingToolbar>
	<columns name="beehexa_hexasync_log_columns">
		<selectionsColumn name="ids">
			<settings>
				<indexField>log_id</indexField>
			</settings>
		</selectionsColumn>
		<column name="log_id">
			<settings>
				<filter>text</filter>
				<sorting>asc</sorting>
				<label translate="true">ID</label>
			</settings>
		</column>
		<column name="profile_name">
			<settings>
				<filter>text</filter>
				<label translate="true">Profile Name</label>
			</settings>
		</column>
		<column name="task_name">
			<settings>
				<filter>text</filter>
				<label translate="true">Task Name</label>
			</settings>
		</column>
		<column name="action_type">
			<settings>
				<filter>text</filter>
				<label translate="true">Action Type</label>
			</settings>
		</column>
		<column name="reference_info" class="\Beehexa\HexaSync\Ui\Component\Listing\Column\StripContent">
			<settings>
				<filter>text</filter>
				<label translate="true">Reference Info</label>
			</settings>
		</column>
		<column name="message" class="\Beehexa\HexaSync\Ui\Component\Listing\Column\StripContent">
			<settings>
				<filter>text</filter>
				<label translate="true">Message</label>
			</settings>
		</column>
		<column name="error" class="\Beehexa\HexaSync\Ui\Component\Listing\Column\StripContent">
			<settings>
				<filter>text</filter>
				<label translate="true">Error Message</label>
			</settings>
		</column>
		<column name="task_status">
			<settings>
				<filter>text</filter>
				<label translate="true">Task Status</label>
			</settings>
		</column>
		<column name="execute_at">
			<settings>
				<filter>text</filter>
				<label translate="true">Execute At</label>
			</settings>
		</column>
		<column name="executed_at">
			<settings>
				<filter>text</filter>
				<label translate="true">Executed At</label>
			</settings>
		</column>
		<column name="retry_count">
			<settings>
				<filter>text</filter>
				<label translate="true">Retry Count</label>
			</settings>
		</column>
		<column name="created_at">
			<settings>
				<filter>text</filter>
				<label translate="true">Log At</label>
			</settings>
		</column>
		<column name="log_detail_id" class="Beehexa\HexaSync\Ui\Component\Listing\Column\AppendURL">
			<settings>
				<filter>text</filter>
				<label translate="true">Detail</label>
				<bodyTmpl>ui/grid/cells/html</bodyTmpl>
			</settings>
		</column>
		<actionsColumn name="actions" class="Beehexa\HexaSync\Ui\Component\Listing\Column\LogActions">
			<settings>
				<indexField>log_id</indexField>
				<resizeEnabled>false</resizeEnabled>
				<resizeDefaultWidth>107</resizeDefaultWidth>
			</settings>
		</actionsColumn>
	</columns>
</listing>
