<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/beehexa/hexasync/connector-information" method="POST">
        <service class="Beehexa\HexaSync\Api\HexaSyncIntegrationInterface" method="saveConnectorInfo"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>
    <route url="/V1/beehexa/hexasync/connector-information" method="GET">
        <service class="Beehexa\HexaSync\Api\HexaSyncIntegrationInterface" method="getConnectorInfo"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>
    <route url="/V1/store-information" method="GET">
        <service class="\Beehexa\HexaSync\Api\StoreInformationInterface" method="getList"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>
    <route url="/V1/store-information/:storeId" method="GET">
        <service class="\Beehexa\HexaSync\Api\StoreInformationInterface" method="get"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>
	<route url="/V1/hexasync/log" method="POST">
		<service class="Beehexa\HexaSync\Api\LogRepositoryInterface" method="save"/>
		<resources>
			<resource ref="Beehexa_HexaSync::log_save"/>
		</resources>
	</route>
	<route url="/V1/hexasync/log/search" method="GET">
		<service class="Beehexa\HexaSync\Api\LogRepositoryInterface" method="getList"/>
		<resources>
			<resource ref="Beehexa_HexaSync::log_view"/>
		</resources>
	</route>
	<route url="/V1/hexasync/log/:logId" method="GET">
		<service class="Beehexa\HexaSync\Api\LogRepositoryInterface" method="get"/>
		<resources>
			<resource ref="Beehexa_HexaSync::log_view"/>
		</resources>
	</route>
	<route url="/V1/hexasync/log/:logId" method="PUT">
		<service class="Beehexa\HexaSync\Api\LogRepositoryInterface" method="save"/>
		<resources>
			<resource ref="Beehexa_HexaSync::log_update"/>
		</resources>
	</route>
	<route url="/V1/hexasync/log/:logId" method="DELETE">
		<service class="Beehexa\HexaSync\Api\LogRepositoryInterface" method="deleteById"/>
		<resources>
			<resource ref="Beehexa_HexaSync::log_delete"/>
		</resources>
	</route>
</routes>
